{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/media-cleanup",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    { "source": "/oeuvre", "destination": "/index.html" },
    { "source": "/illustrations", "destination": "/index.html" },
    { "source": "/ceramics", "destination": "/index.html" },
    { "source": "/paintings", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
